# automate_sol_bot configuration — copy to .env and fill in

# -- credentials -----------------------------------------------------------
WALLET_PRIVATE_KEY=             # base58 Solana keypair (required for live)
JUPITER_API_KEY=
BOT_TOKEN=
CHAT_ID=

# -- trading ---------------------------------------------------------------
DRY_RUN=true
STARTING_AMOUNT_USDC=2.00
SLIPPAGE_BPS=150

# -- entry filters -----------------------------------------------------------
MAX_AGE_SECONDS=600
MIN_LIQUIDITY_USD=1500
MAX_LIQUIDITY_USD=500000
MIN_TXNS_5M=6
MIN_BUYS_5M=4
MIN_BUY_SELL_RATIO=1.1
MIN_VOLUME_5M=250
MAX_MARKET_CAP=10000000

# -- scanner pipeline ---------------------------------------------------------
# Bounded work queue + worker pool; DexScreener lookup is best-effort for 90s
# (most pump launches are never indexed, so they skip straight to the quote).
MAX_PENDING_EVALUATIONS=500
MAX_EVALUATION_WORKERS=25
MAX_SCAN_WINDOW_SEC=90

# -- Jupiter quote-gate (tradability check before any trade) ------------------
MAX_PRICE_IMPACT_PCT=10.0
QUOTE_RETRIES=5
QUOTE_RETRY_DELAY_SEC=0.5
QUOTE_RATE_PER_SEC=20
QUOTE_CACHE_TTL_SEC=1.5
# slippage chosen by pool liquidity: floor_bps:min_liq, ..., inf:bps
SLIPPAGE_TIERS=20000:2000,100000:1000,inf:300

# -- exits ------------------------------------------------------------------
TAKE_PROFIT_MULT=2.0
STOP_LOSS_MULT=0.82
DEAD_POOL_LIQUIDITY_USD=25
POLL_INTERVAL_SEC=8
MAX_HOLD_SECONDS=600

# -- risk & compounding --------------------------------------------------------
PLAY_FLOOR_USD=1.00
MAX_CONSEC_LOSSES=2
LOSS_PAUSE_SEC=300
DEAD_POOL_CHECK_SEC=600
REINVEST_RATIO=0.6
